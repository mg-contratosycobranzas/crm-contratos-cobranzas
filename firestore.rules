rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Cambia este correo por el de la administradora principal:
    function owner() { return request.auth != null && request.auth.token.email == 'TU_CORREO@gmail.com'; }
    function acl() { return get(/databases/$(db)/documents/meta/acl).data; }
    function member() { return owner() || (request.auth != null && request.auth.token.email in acl().members); }
    function admin() { return owner() || (request.auth != null && request.auth.token.email in acl().admins); }

    match /meta/{d} { allow read: if member(); allow write: if admin(); }
    match /ops/{d} { allow read, create, update: if member(); allow delete: if admin(); }
    match /seguimientos/{d} { allow read, create, update: if member(); allow delete: if admin(); }
    match /log/{d} { allow read, create: if member(); allow update, delete: if false; }
  }
}
